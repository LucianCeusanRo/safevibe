# Copy to .env as needed. Cloud is never the silent default.
# SAFE_VIBE_BACKEND=ollama
# SAFE_VIBE_OLLAMA_BASE=http://127.0.0.1:11434/v1
# SAFE_VIBE_MODEL=llama3.2
# SAFE_VIBE_BIND=127.0.0.1
# SAFE_VIBE_PORT=8787
# SAFE_VIBE_DICTIONARY=examples/org-dictionary.yml
# SAFE_VIBE_AUDIT_LOG=$HOME/.local/share/safevibe/audit.jsonl
# SAFE_VIBE_LOG_REDACTED_PROMPTS=false

# Only if you explicitly choose a cloud or other OpenAI-compatible upstream:
# SAFE_VIBE_BACKEND=openai
# SAFE_VIBE_OPENAI_BASE=https://api.openai.com/v1
# SAFE_VIBE_API_KEY=replace-me
